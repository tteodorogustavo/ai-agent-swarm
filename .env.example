# Copy this file to .env and fill secrets. Do NOT commit .env.

# OpenAI key (required for LLM and embeddings)
OPENAI_API_KEY=

# Tavily API key (required for web search functionality)
# Get your key at: https://tavily.com
TAVILY_API_KEY=

# Toggle tracing (true/false)
ENABLE_TRACING=false

# When set to "true" the /chat endpoint will return a mock response instead
# of invoking the full graph (useful for local dev without keys).
MOCK_GRAPH=false

# Optional user agent string for web requests
USER_AGENT=ai-agent-swarm-local

# ============================================================================
# NOTIFICATION SETTINGS
# ============================================================================

# Notification Providers (comma-separated: slack, email, console)
# Examples:
#   - Production: NOTIFICATION_PROVIDERS=slack,email
#   - Development: NOTIFICATION_PROVIDERS=console
#   - Testing: NOTIFICATION_PROVIDERS=slack,email,console
NOTIFICATION_PROVIDERS=console

# Enable fallback to next provider if one fails (true/false)
NOTIFICATION_FALLBACK=true

# ----------------------------------------------------------------------------
# Slack Configuration (optional)
# ----------------------------------------------------------------------------
# Get webhook URL from: https://api.slack.com/apps
# 1. Create new app → "Incoming Webhooks"
# 2. Activate webhooks and add to workspace
# 3. Copy webhook URL below
SLACK_WEBHOOK_URL=
